{
  "schema_version": 4,
  "api_version": "v1",
  "base": "https://api.github.com/repos/snq360/Cro/contents/data",
  "auth": {
    "header": "Authorization: token <TOKEN>",
    "note": "token不写入仓库文件"
  },
  "tables": {
    "users": {
      "path": "users/users.json",
      "id_field": "id",
      "fields": [
        "id",
        "username",
        "nickname",
        "avatarColor",
        "bio",
        "isAdmin",
        "isVip",
        "banned",
        "created_at",
        "last_seen"
      ]
    },
    "videos": {
      "path": "videos/videos.json",
      "id_field": "id",
      "fields": [
        "id",
        "userId",
        "username",
        "avatarColor",
        "text",
        "url",
        "music",
        "timeMs",
        "likes",
        "comments",
        "views",
        "liked",
        "following"
      ]
    },
    "comments": {
      "path": "comments/comments.json",
      "id_field": "id",
      "fields": [
        "id",
        "videoId",
        "userId",
        "username",
        "avatarColor",
        "content",
        "timeMs"
      ]
    },
    "messages": {
      "path": "messages/messages.json",
      "id_field": "id",
      "fields": [
        "id",
        "from_id",
        "to_id",
        "type",
        "content",
        "timeMs",
        "recalled"
      ]
    },
    "follows": {
      "path": "follows/follows.json",
      "id_field": "id",
      "fields": [
        "id",
        "follower_id",
        "followee_id",
        "timeMs"
      ]
    },
    "likes": {
      "path": "likes/likes.json",
      "id_field": "id",
      "fields": [
        "id",
        "user_id",
        "video_id",
        "timeMs"
      ]
    },
    "notifications": {
      "path": "notifications/notifications.json",
      "id_field": "id",
      "fields": [
        "id",
        "user_id",
        "type",
        "title",
        "body",
        "read",
        "created_at"
      ]
    }
  },
  "operations": {
    "read": "GET {table_path} → {content: base64, sha}",
    "write": "PUT {table_path} body={content: base64, sha, message}",
    "insert": "read → append to array → write",
    "update": "read → find by id → merge patch → write",
    "delete": "read → filter out by id → write"
  },
  "error_codes": {
    "0": "成功",
    "401": "token无效/过期",
    "403": "封禁/权限不足/设备重复注册(业务码4031)",
    "404": "文件不存在→当空数组",
    "409": "sha冲突→重读merge重试≤5次",
    "422": "参数校验失败",
    "429": "API限流5000/h→等待重试",
    "500": "服务端错误→重试2次"
  },
  "compat_rules": [
    "只增不改",
    "旧客户端忽略新字段",
    "新字段必须有默认值"
  ]
}